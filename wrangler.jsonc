{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "turborepo-remote-cache",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-19",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "turbo-cache.freecodecamp.net",
			"custom_domain": true
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"BUCKET_OBJECT_EXPIRATION_HOURS": 72
	},
	"r2_buckets": [
		{
			"binding": "R2_STORE",
			"bucket_name": "turborepo-cache"
		}
	],
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	}
}